# ─────────────────────────────────────────────────────────────────────────────
# Babajan Sumangali — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site (no trailing slash). Used for auth callbacks,
# canonical URLs, sitemap, and email links.
APP_URL=http://localhost:3000

# Deployment stage: development | staging | production.
# Anything other than "production" adds `noindex` and blocks crawlers.
APP_ENV=development

# PostgreSQL. `npm run db:local` starts an embedded server matching these values.
DATABASE_URL=postgres://babajan:babajan-local-dev@localhost:5433/babajan
TEST_DATABASE_URL=postgres://babajan:babajan-local-dev@localhost:5433/babajan_test

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Require customers to verify their email before signing in (true/false).
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── Payments ────────────────────────────────────────────────────────────────
# PAYMENT_PROVIDER: "razorpay" or "test". The "test" adapter is refused when
# APP_ENV=production.
PAYMENT_PROVIDER=test
# Shared secret used to sign simulated webhook events from the test adapter.
TEST_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-string
# Razorpay (use rzp_test_ keys until live readiness is confirmed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: "console" (logs to server output + dev outbox table) or "resend".
EMAIL_PROVIDER=console
EMAIL_FROM="Babajan Sumangali <orders@example.com>"
RESEND_API_KEY=

# ── Operations ──────────────────────────────────────────────────────────────
# Bearer token for /api/cron/* endpoints (expire unpaid orders, etc.).
CRON_SECRET=replace-with-a-random-string
# Set to "true" to show the maintenance page to all non-admin visitors.
MAINTENANCE_MODE=false

# ── Development seed only (ignored when APP_ENV=production) ────────────────
SEED_ADMIN_EMAIL=admin@babajan.test
SEED_ADMIN_PASSWORD=Dev-only-Admin-2026!
SEED_STAFF_EMAIL=staff@babajan.test
SEED_STAFF_PASSWORD=Dev-only-Staff-2026!
SEED_CUSTOMER_EMAIL=customer@babajan.test
SEED_CUSTOMER_PASSWORD=Dev-only-Customer-2026!
